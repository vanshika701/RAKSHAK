# ===== Datasets =====
# Raw CICIDS2017 / UNSW-NB15 CSVs — gigabytes, publicly downloadable (see instructions.md)
data/raw/

# Processed parquet — regenerated by src/preprocess.py
data/processed/

# ===== Trained models =====
# .joblib files are large binaries, regenerated by src/train_model.py.
# selected_features.json is intentionally NOT ignored (see CLAUDE.md).
models/*.joblib

# ===== Python =====
__pycache__/
*.pyc

# ===== Live detection runtime data =====
# Regenerated by src/detector.py every run - not source, not reproducible
# from the repo alone (it's whatever traffic your machine happened to see).
detections.db
models/tuned_from_colab/

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== macOS =====
.DS_Store

# ===== Secrets / local config =====
.env
